--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
@@ -430,10 +430,18 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
         currentlyMapped = this.entityByUUID.putIfAbsent(entity.getUUID(), entity);
         if (currentlyMapped != null) {
-            // need to remove mapping for id
-            this.entityById.remove((long)entity.getId(), entity);
-            LOGGER.warn("Entity uuid already exists: " + entity.getUUID() + ", mapped to " + currentlyMapped + ", can't add " + entity);
-            return false;
+            // Baguette start - regenerate UUID instead of failing (Fireballs/CMI plugin bypass fix)
+            final java.util.UUID oldUUID = entity.getUUID();
+            final java.util.UUID newUUID = java.util.UUID.randomUUID();
+            entity.setUUID(newUUID);
+            final Entity secondAttempt = this.entityByUUID.putIfAbsent(newUUID, entity);
+            if (secondAttempt != null) {
+                this.entityById.remove((long)entity.getId(), entity);
+                LOGGER.warn("Entity uuid collision after regeneration: " + newUUID + ", mapped to " + secondAttempt + ", can't add " + entity);
+                return false;
+            }
+            LOGGER.debug("Baguette: Regenerated duplicate UUID {} -> {} for {} at {}", oldUUID, newUUID, entity.getType().getDescriptionId(), entity.blockPosition());
+            // Baguette end
         }
 
         ((ChunkSystemEntity)entity).moonrise$setSectionX(sectionX);
